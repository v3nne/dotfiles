#####################
### SANE DEFAULTS ###
#####################

set-option -g status-position top
set -g set-titles on
# set -g set-titles-string "tmuxctx:R:{{ .chezmoi.hostname }} #S:#I:#W"

# Make sure the cursor remains a bar instead of becoming a block
# set -ga terminal-features ',*:extcursors'
set -ga terminal-features ',*:usstyle'

# Refresh status every 5 seconds (Default is 15)
set-option -g status-interval 5

# Set true color
set -as terminal-overrides ',xterm-256color*:XT'
set -as terminal-features ",*:RGB"

# Pass focus event to Claude
set -g focus-events on

# vim motions in various modes (copy-mode, select-session, etc)
set-window-option -g mode-keys vi

# Increase history to scroll further back in copy mode
set -g history-limit 10000

# Vim-y selection in copy-mode-vi
set -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi V send -X select-line
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-selection-and-cancel
bind -T copy-mode-vi Y send -X copy-end-of-line
bind -T copy-mode-vi Escape send -X clear-selection

# Block cursor in copy mode, back to normal on exit
set-hook -g pane-mode-changed 'if -F "#{pane_in_mode}" "set -p cursor-style block" "set -p cursor-style default"'

# Set prefix to Ctrl+space
unbind C-b
set -g prefix C-space
bind C-space send-prefix

# prefix+C-j enters copy mode
unbind [
bind C-j copy-mode

# Copy to system clipboard
set -g set-clipboard on

# Enable more key combinations
set -g xterm-keys on

# Enable pleb mode
set -g mouse on

# Start windows and panes at 1, not 0
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1



####################
### KEY BINDINGS ###
####################

# Move panes with Alt+Ctrl+h/j/k/l
# bind -n M-C-h swap-pane -t '{left-of}' \; select-pane -t '{left-of}'
# bind -n M-C-j swap-pane -D
# bind -n M-C-k swap-pane -U
# bind -n M-C-l swap-pane -t '{right-of}' \; select-pane -t '{right-of}'
bind -n M-C-h swap-pane -t '{left-of}' \; select-pane -t '{left-of}'
bind -n M-C-j swap-pane -t '{down-of}' \; select-pane -t '{down-of}'
bind -n M-C-k swap-pane -t '{up-of}' \; select-pane -t '{up-of}'
bind -n M-C-l swap-pane -t '{right-of}' \; select-pane -t '{right-of}'

# Split horizontally with Alt+s
unbind-key '"'
bind -n M-s split-window -v -c "#{pane_current_path}"
# Split vertically with Alt+v
unbind-key %
bind -n M-v split-window -h -c "#{pane_current_path}" 

# Kill pane with Alt+Esc
bind -n M-Escape confirm-before -p "Kill pane #P? (y/n)" kill-pane

# Bind Alt+m to maximize (zoom) pane
bind -n M-m resize-pane -Z


# Navigate prev/next window with Alt+;/'
bind -n M-\; previous-window
bind -n M-\' next-window

# Move window left/right with Ctrl+Shift+;/'
bind -n M-\: swap-window -d -t:-1
bind -n M-\" swap-window -d -t:+1

# Bind Alt+q … Alt+p to windows 1–10
bind-key -n M-q selectw -t 1
bind-key -n M-w selectw -t 2
bind-key -n M-e selectw -t 3
bind-key -n M-r selectw -t 4
bind-key -n M-t selectw -t 5
bind-key -n M-y selectw -t 6
bind-key -n M-u selectw -t 7
bind-key -n M-i selectw -t 8
bind-key -n M-o selectw -t 9
bind-key -n M-p selectw -t 10

# Rename window with Alt+g
bind-key -n M-g command-prompt -I "#W" "rename-window '%%'"

# New window with Alt+n
bind-key -n M-n new-window -c "#{pane_current_path}"

# Kill window with Ctrl+w
bind -n C-w confirm-before -p "Kill window #W? (y/n)" kill-window

# Rename session with prefix+g
bind-key g command-prompt -I "#S" "rename-session '%%'"

# Switch to next session with Ctrl+'
bind-key -n C-"'" switch-client -n

# Switch to previous session with Ctrl+;
bind-key -n C-\; switch-client -p

# Toggle last session with Alt+Tab
bind-key -n M-Tab switch-client -l

# New session with prefix+n
bind-key n new-session

# Kill session with prefix+w, then stay attached to the last/next session
bind-key w confirm-before -p "Kill session #S? (y/n)" "run-shell 'tmux switch-client -l 2>/dev/null || tmux switch-client -n; tmux kill-session -t \"#S\"'"


##############
### STATUS ###
##############

set -g status-style "bg=default,fg=default"
set -g status-justify left
set -g status-left ""
set -g status-right "#S #[fg=#ecece8,bg=#516e7d]  #h "
set -g status-right-length 60
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "
set -g window-status-style "bg=default,fg=default"
set -g window-status-current-style "fg=#ecece8,bg=#54546D"
set -g window-status-separator ""
{{- if eq .chezmoi.os "darwin" }}
# Keep the active-window colors aligned with Ghostty's macOS appearance.
run-shell -b "~/.config/tmux/tmux-status-theme.sh --watch"
{{- end }}

# Active pane divider color
set -g pane-active-border-style "fg=#E46876"

# tmux UI colors
# Popups use the terminal's colors (tmux 3.8 defaults them to a grey theme)
set -g popup-style default
set -g popup-border-style default
# set-option -g mode-style "bg=#928374,fg=#1d2021,bold" # session select, copy, etc
# set-option -g message-style "fg=#bdae93,bg=default" # messages in status bar


##############
### PUGINS ###
##############

# Plugin manager
set -g @plugin 'tmux-plugins/tpm'

# Fuzzy session/window/pane picker
set -g @plugin 'sainnhe/tmux-fzf'
TMUX_FZF_LAUNCH_KEY="F"
set -g @tmux-fzf-launch-key 'F'
TMUX_FZF_OPTIONS="-p -w 90% -h 90% -m --bind=ctrl-l:accept --bind=right:accept"
bind-key C-space run-shell -b "~/.config/tmux/plugins/tmux-fzf/scripts/session.sh switch"
bind-key J run-shell -b "~/.config/tmux/plugins/tmux-fzf/main.sh"

# Navigate in/out of vim & tmux
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @vim_navigator_mapping_left "M-h"
set -g @vim_navigator_mapping_down "M-j"
set -g @vim_navigator_mapping_up "M-k"
set -g @vim_navigator_mapping_right "M-l"

# Resize in/out of vim & tmux
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
# set -g @plugin 'RyanMillerC/better-vim-tmux-resizer'
bind-key -n M-H if-shell "$is_vim" "send-keys M-H" "resize-pane -L 4"
bind-key -n M-J if-shell "$is_vim" "send-keys M-J" "resize-pane -D 2"
bind-key -n M-K if-shell "$is_vim" "send-keys M-K" "resize-pane -U 2"
bind-key -n M-L if-shell "$is_vim" "send-keys M-L" "resize-pane -R 4"
# bind-key -T copy-mode-vi M-H resize-pane -L 4
# bind-key -T copy-mode-vi M-J resize-pane -D 2
# bind-key -T copy-mode-vi M-K resize-pane -U 2
# bind-key -T copy-mode-vi M-L resize-pane -R 4

# Save/restore tmux server state across reboots
# set -g @plugin 'tmux-plugins/tmux-resurrect'
# set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-processes 'nvim vim lazygit lazydocker ssh htop btop'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '5'

# Run the plugins
run '~/.config/tmux/plugins/tpm/tpm'
