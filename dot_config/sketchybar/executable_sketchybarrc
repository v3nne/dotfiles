sketchybar --add event tmux_update
sketchybar --add event aerospace_workspace_change
sketchybar --add event ghostty_focus


##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

# Focus controller: the single authority over which tmux context the bar draws.
# Runs on ghostty_focus (AeroSpace focus change) and front_app_switched for
# snappy switches, plus a ~1s safety tick (tmux is entered manually, so the
# title marker can appear with no focus change). It governs visibility of the
# local tmux.win.* items and tmux_session; front_app.sh / tmux.sh defer to it.
# Has no visual presence of its own (drawing=off).
sketchybar --add item focus left \
  --set focus drawing=off update_freq=1 script="$PLUGIN_DIR/focus.sh" \
  --subscribe focus ghostty_focus front_app_switched

sketchybar --add item front_app left \
  --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched \
  --add item tmux left \
  --set tmux icon.drawing=off padding_left=0 label.padding_left=0 script="$PLUGIN_DIR/tmux.sh" drawing=off \
  --subscribe tmux tmux_update

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
  --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
  --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change \
  --add item layout right \
  --set layout update_freq=4 script="$PLUGIN_DIR/keyboard_layout.sh" \
  --add item aerospace right \
  --set aerospace script="$PLUGIN_DIR/aerospace.sh" width=35 \
  --subscribe aerospace aerospace_workspace_change \
  --add item tmux_session right \
  --set tmux_session icon.drawing=off script="$PLUGIN_DIR/tmux_session.sh" drawing=off \
  --subscribe tmux_session tmux_update \
  --add item tmux_rsession right \
  --set tmux_rsession icon.drawing=off drawing=off \
  --add item devbox_badge right \
  --set devbox_badge icon.drawing=off label="devbox" \
    label.color="$BADGE_FG" background.color="$BADGE_BG" background.height=18 \
    background.corner_radius=4 background.drawing=on drawing=off \
  --add item devbox_unreachable right \
  --set devbox_unreachable icon.drawing=off label="devbox ⚠ unreachable" \
    label.color="$UNREACHABLE_FG" drawing=off \

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
