#!/bin/bash
# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Shared theme palette (window-list colors + devbox badge accent), the single
# source of truth also sourced by the tmux plugins. See plugins/palette.sh.
# shellcheck source=plugins/palette.sh
. "$PLUGIN_DIR/palette.sh"

# Reset the tmux render state on (re)load so both window lists rebuild from
# scratch -- a reload never leaves a wedged or stale window list (local or
# remote) behind. The LOCAL section persists only its render cache; the REMOTE
# section persists more, and ALL of it must be cleared to give the remote section
# the same clean-reload guarantee. What each path is, and what staleness it would
# cause if left behind:
#   - *.cache      render caches (local + remote): without these a stale cache
#                  could short-circuit the first rebuild's reconciliation
#   - rtmux.state  the offline state machine's prev_state/fail_count -- stale, it
#                  could resume the grace machine mid-failure (e.g. straight into
#                  `unreachable`) instead of a clean start
#   - rtmux.connected  the "a real remote list was drawn" marker -- stale, the
#                  first post-reload `stale` tick would hold a list that no longer
#                  exists on the freshly-loaded bar
#   - *.lock / ctl.lock  the mkdir-mutex dirs: a process killed mid-render during
#                  the reload can leave one behind, wedging the first render for
#                  up to its stale-break window (5s for the render locks, 15s for
#                  the controller's ctl.lock)
# The fresh sketchybar process starts with an empty item set, so the tmux.rwin.*
# items themselves are gone on reload; clearing the state above is what keeps the
# rebuilt section from going stale or wedged.
#
# This list must stay in sync with the remote state files focus.sh actually
# writes (its R* declarations: RCACHE/RSTATE/RCONNECTED/RLOCK/RCTLLOCK). A new
# remote state file added there but forgotten here reopens the stale-state bug.
CACHE="$HOME/.cache/sketchybar_"
rm -rf \
  "${CACHE}tmux.cache" \
  "${CACHE}tmux.lock" \
  "${CACHE}rtmux.cache" \
  "${CACHE}rtmux.state" \
  "${CACHE}rtmux.connected" \
  "${CACHE}rtmux.lock" \
  "${CACHE}rtmux.ctl.lock"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# MacOS renders sketchybar through another renderer pipeline
# which results in slightly different color
# technically is the correct background color 0xff1F1F28
sketchybar --bar \
  position=top \
  height=34 \
  color=0xff202028 \
  blur_radius=0 \
  shadow=off \
  border_width=0 \
  corner_radius=0 \
  margin=0

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=0
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Regular:14.0"
  label.font="JetBrainsMono Nerd Font Mono:Regular:14.0"
  icon.color=0xffB4B09B
  label.color=0xffB4B09B
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding Mission Control Space Indicators #####
